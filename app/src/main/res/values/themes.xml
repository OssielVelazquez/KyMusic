<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema normal de la aplicación -->
    <style name="Theme.KyMusic" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>


    <!-- Splash que aparece antes de cargar Compose -->
    <style name="Theme.KyMusic.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_image</item>
        <item name="postSplashScreenTheme">@style/Theme.KyMusic</item>
    </style>

</resources>